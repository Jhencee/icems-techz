{
  "version": 2,
  "routes": [
    { "src": "/downloads/(.*).apk", "headers": { "Content-Type": "application/vnd.android.package-archive", "Content-Disposition": "attachment; filename=ICEMS.apk" }, "dest": "/downloads/$1.apk" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/user/(.*)", "dest": "/user/$1" },
    { "src": "/super-admin/(.*)", "dest": "/super admin/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
